# special characters in a single connection-string field)
PGHOST=ee7ff30fe812a463a2b68630.twc1.net
PGPORT=5432
PGUSER=gen_user
PGPASSWORD=your-password-here
PGDATABASE=salon

# Alternative: a single connection string (used only if the PG* vars above
# are not all set). Percent-encode special characters in the password,
# e.g. > becomes %3E.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
