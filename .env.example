PORT=8787

# Preferred: discrete connection fields (safer with hosting UIs that mangle
# special characters in a single connection-string field)
PGHOST=ee7ff30fe812a463a2b68630.twc1.net
PGPORT=5432
PGUSER=gen_user
PGPASSWORD=your-password-here
PGDATABASE=salon

# Alternative: a single connection string (used only if the PG* vars above
# are not all set). Percent-encode special characters in the password,
# e.g. > becomes %3E.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Timeweb S3 object storage — used for master photo uploads so files survive
# redeploys (App Platform's own filesystem is ephemeral/read-only). If these
# are not set, uploads fall back to local disk (fine for local dev only).
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
